<html>
  <head>
    <title>Send Report</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Poppins:wght@500;600&display=swap" rel="stylesheet"/>
    <link rel="icon" href="/pngtree-passenger-coach-bus-woodcut-png-image_10206746.png">

    <style>
      body {
        margin: 0;
        font-family: "Inter", sans-serif;
        background: linear-gradient(135deg, #dbeafe, #f8fafc);
        color: #1e293b;
      }

      /* ---------------- Loading Screen ---------------- */
      #loadingOverlay {
        display: none;
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background: rgba(255,255,255,0.85);
        z-index: 99999;
        justify-content: center;
        align-items: center;
        flex-direction: column;
      }

      .spinner {
        width: 60px;
        height: 60px;
        border: 6px solid #cbd5e1;
        border-top-color: #2563eb;
        border-radius: 50%;
        animation: spin 0.9s linear infinite;
      }

      @keyframes spin {
        to { transform: rotate(360deg); }
      }

      #loadingOverlay p {
        margin-top: 15px;
        font-size: 18px;
        font-weight: 600;
        color: #1e3a8a;
      }

      /* ---------------- Top Notification ---------------- */
      .top-message {
        display: none;
        position: fixed;
        top: 20px;
        left: 50%;
        transform: translateX(-50%);
        min-width: 300px;
        padding: 14px 20px;
        border-radius: 10px;
        font-size: 16px;
        font-weight: 500;
        box-shadow: 0 4px 16px rgba(0,0,0,0.18);
        z-index: 10000;
      }

      .success { background-color: #d1fae5; color: #065f46;  }
      .error   { background-color: #fee2e2; color: #7f1d1d;  }

      .close-btn { margin-left: 10px; background: none; border: none; font-size: 20px; cursor: pointer; }

      /* ---------------- Form Styling ---------------- */
      .container {
        display: flex;
        justify-content: center;
        margin-top: 40px;
      }

      .form-container {
        background: #ffffff;
        padding: 15px 15px;
        border-radius: 14px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        width: 100%;
        max-width: 430px;
        animation: fadeUp 0.6s ease;
      }

      @keyframes fadeUp {
        from { transform: translateY(20px); opacity: 0; }
        to   { transform: translateY(0); opacity: 1; }
      }

      h2 {
        text-align: center;
        font-family: "Poppins";
        margin-bottom: 25px;
        font-weight: 600;
        font-size: 24px;
        color: black;
      }

      label {
        font-weight: 600;
        color: #334155;
        margin-bottom: 6px;
        display: block;
      }

      .input-box {
        margin-bottom: 20px;
      }

      input {
        width: 100%;
        padding: 14px 16px;
        border: 2px solid #cbd5e1;
        border-radius: 8px;
        font-size: 15px;
        transition: 0.3s;
      }

      input:focus {
        border-color: #2563eb;
        box-shadow: 0 0 7px rgba(37, 99, 235, 0.35);
        outline: none;
      }

      button {
        width: 100%;
        padding: 14px;
        background: #2563eb;
        color: #fff;
        border: none;
        border-radius: 10px;
        font-size: 17px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.3s;
      }

      button:hover {
        background: #1e3a8a;
      }
    </style>
  </head>

  <body>
    {{> navbar }}

    <!-- Loading Screen -->
    <div id="loadingOverlay">
      <div class="spinner"></div>
      <p>Sending report, please wait...</p>
    </div>

    <!-- Notification Message -->
    <div id="top-message" class="top-message">
      <span id="message-text"></span>
      <button onclick="hideMessage()" class="close-btn">&times;</button>
    </div>

    <div class="container">
      <div class="form-container">
        <h2>Send Bus Report by E-mail</h2>

        <form id="reportForm" action="/Auth/send-report" method="post">
          
          <div class="input-box">
            <label>Enter Year</label>
            <input type="number" name="year" placeholder="Eg: 2025" required />
          </div>

          <div class="input-box">
            <label>Enter Month (1–12)</label>
            <input type="number" name="month" placeholder="Eg: 6" min="1" max="12" required />
          </div>

          <div class="input-box">
            <label>Admin Email</label>
            <input type="email" name="adminEmail" placeholder="admin@example.com" required />
          </div>

          <button type="submit">Send Report</button>
        </form>
      </div>
    </div>

    <script>
      // Show loading animation when form submitted
      const form = document.getElementById("reportForm");
      const loading = document.getElementById("loadingOverlay");

      form.addEventListener("submit", () => {
        loading.style.display = "flex";
      });

      // Show Notification Message
      const msg = "{{msg}}";
      const type = "{{msg_type}}";

      function hideMessage() {
        document.getElementById("top-message").style.display = "none";
      }

      if (msg) {
        const box = document.getElementById("top-message");
        document.getElementById("message-text").innerText = msg;
        box.classList.add(type === "Good" ? "success" : "error");
        box.style.display = "flex";

        // Auto-hide
        setTimeout(() => { box.style.display = "none"; }, 4000);

        // Remove loading screen if message came back
        loading.style.display = "none";
      }
    </script>
  </body>
</html>
